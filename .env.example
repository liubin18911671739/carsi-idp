###############################################################################
# CARSI / Shibboleth IdP 5.2.2 — 环境变量模板
# 用法:  cp .env.example .env  &&  按注释填写  &&  chmod 600 .env
# .env 绝不进 git（已在 .gitignore 中）。
###############################################################################

# ── 1. 身份标识（必须与 DNS / TLS / EntityID 完全一致）─────────────────────
# 正式上线改成真实域名，例如 idp.youruniversity.edu.cn
IDP_HOSTNAME=idp.test.local
# institution scope，用于 eduPersonScopedAffiliation 等属性
# 正式改成 youuniversity.edu.cn（不带 https:// 和路径）
IDP_SCOPE=test.local
# EntityID，官方默认为 https://<hostname>/idp/shibboleth
IDP_ENTITY_ID=https://idp.test.local/idp/shibboleth

# ── 2. IdP 显示信息（元数据/登录页展示，中英文均可）───────────────────────
IDP_DISPLAY_NAME_ZH=测试大学统一身份认证
IDP_DISPLAY_NAME_EN=Test University Identity Provider
# 管理员邮箱，会写进 IdP metadata 的 <ContactPerson>
IDP_ADMIN_EMAIL=admin@test.local

# ── 3. 口令（全部用于容器内凭据文件，绝不 baked 进镜像）───────────────────
# sealer（加密持久化 ID 的 AES 密钥库）；不含空格和点
SEALER_STORE_PASSWORD=ChangeMeSealerStore2026
SEALER_KEY_PASSWORD=ChangeMeSealerKey2026
# backchannel / 内部 p12 口令
BACKCHANNEL_KEYSTORE_PASSWORD=ChangeMeBackchannel2026
# Jetty 自身 TLS keystore（ENABLE_SSL=1 时用；正式部署建议反代终止 TLS，可留默认）
JETTY_KEYSTORE_PASSWORD=ChangeMeJettyTLS2026

# ── 4. 持久化 ID salt（跨重启必须一致，否则所有 SP 的 eptid 全变）─────────
PERSISTENT_ID_SALT=ChangeMePersistentIdSalt2026

# ── 5. TLS（默认交给 nginx 反代终止；IdP 容器内只跑 http:8080 + backchannel:8443）
# 置 1 则 IdP 容器自身监听 8443（自签，一般不需要，除非不用反代）
ENABLE_SSL=0
ENABLE_SEALER=0

# ── 6. 时区（镜像硬编码 Europe/Helsinki，必须覆盖，SAML 对时间敏感）───────
TZ=Asia/Shanghai
